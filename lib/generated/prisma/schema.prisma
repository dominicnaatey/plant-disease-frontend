generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Prediction {
  id         String   @id @default(cuid())
  imageUrl   String
  prediction String
  confidence Float
  heatmapUrl String
  feedback   Int?
  createdAt  DateTime @default(now())
}
